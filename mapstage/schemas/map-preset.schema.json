{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.local/mapstage/schemas/map-preset.schema.json",
  "title": "China antique MapLibre preset",
  "type": "object",
  "required": ["id", "version", "camera", "maplibre", "css", "ui"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "savedAt": { "type": "string" },
    "camera": {
      "type": "object",
      "required": ["center", "zoom"],
      "properties": {
        "center": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "zoom": { "type": "number" },
        "pitch": { "type": "number" },
        "bearing": { "type": "number" }
      },
      "additionalProperties": false
    },
    "maplibre": {
      "type": "object",
      "required": ["backgroundColor", "terrainExaggeration", "satellite", "hillshade", "water"],
      "properties": {
        "backgroundColor": { "type": "string" },
        "terrainExaggeration": { "type": "number" },
        "satellite": {
          "type": "object",
          "properties": {
            "opacity": { "type": "number" },
            "saturation": { "type": "number" },
            "contrast": { "type": "number" },
            "brightnessMin": { "type": "number" },
            "brightnessMax": { "type": "number" },
            "hueRotate": { "type": "number" }
          },
          "additionalProperties": true
        },
        "hillshade": {
          "type": "object",
          "properties": {
            "exaggeration": { "type": "number" },
            "illuminationDirection": { "type": "number" },
            "shadowColor": { "type": "string" },
            "highlightColor": { "type": "string" },
            "accentColor": { "type": "string" }
          },
          "additionalProperties": true
        },
        "water": {
          "type": "object",
          "properties": {
            "lakeFill": { "type": "string" },
            "lakeOutline": { "type": "string" },
            "riverLevel3": { "type": "string" },
            "riverLevel2": { "type": "string" },
            "riverLevel1": { "type": "string" },
            "highlightRiver": { "type": "string" },
            "qilianRiver": {
              "type": "string",
              "description": "Legacy alias of highlightRiver"
            },
            "riverL3Width": { "type": "number" },
            "riverL2Width": { "type": "number" },
            "riverL1Width": { "type": "number" },
            "highlightWidth": { "type": "number" },
            "qilianWidth": {
              "type": "number",
              "description": "Legacy alias of highlightWidth"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "css": {
      "type": "object",
      "properties": {
        "sepia": { "type": "number" },
        "saturate": { "type": "number" },
        "contrast": { "type": "number" },
        "brightness": { "type": "number" },
        "hueRotate": { "type": "number" },
        "warmTintAlpha": { "type": "number" },
        "warmTintColor": { "type": "string" },
        "vignetteStrength": { "type": "number" }
      },
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "properties": {
        "showWater": { "type": "boolean" },
        "showHighlight": { "type": "boolean" },
        "showQilian": {
          "type": "boolean",
          "description": "Legacy alias of showHighlight"
        },
        "showCities": { "type": "boolean" },
        "showRef": { "type": "boolean" },
        "showRiverLabels": { "type": "boolean" },
        "refMode": { "type": "string", "enum": ["pip", "split"] }
      },
      "additionalProperties": true
    },
    "cities": {
      "type": "object",
      "properties": {
        "dataFile": { "type": "string" },
        "halfKm": { "type": "number" },
        "renderMode": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
